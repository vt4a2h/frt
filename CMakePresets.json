{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "FRT_ENABLE_TESTING": "ON",
        "FRT_ENABLE_BENCHMARKING": "OFF",
        "FRT_DEV_MODE": "ON",
        "FRT_DEPENDENCIES_FROM_CPM": "OFF"
      }
    },
    {
      "name": "base-ci",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FRT_ENABLE_BENCHMARKING": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Default host compiler",
      "description": "Configuring for your system with the default compiler",
      "inherits": "base"
    },
    {
      "name": "host-clang",
      "displayName": "Default host clang",
      "description": "Configuring for your system with the default clang version",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -lc++abi"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "CXXFLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "linux-gcc-16",
      "displayName": "Linux GCC 16",
      "description": "Configuring for Linux with GCC 16",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16"
      },
      "environment": {
        "CC": "gcc-16",
        "CXX": "g++-16"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-16-non-hardened",
      "displayName": "Linux GCC 16",
      "description": "Configuring for Linux with GCC 16",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "FRT_HARDENED": "OFF"
      },
      "environment": {
        "CC": "gcc-16",
        "CXX": "g++-16"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-23",
      "displayName": "Linux Clang 23",
      "description": "Configuring for Linux with Clang 23",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-23",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-23",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -Wno-c2y-extensions -Wno-error=c2y-extensions",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -lc++abi",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -lc++abi"
      },
      "environment": {
        "CC": "/usr/bin/clang-23",
        "CXX": "/usr/bin/clang++-23",
        "CXXFLAGS": "-stdlib=libc++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "mac-clang",
      "displayName": "Mac Clang",
      "description": "Configuring for macOS with Clang",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows Clang",
      "description": "Configuring for Windows with Clang (clang-cl)",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Configuring for Windows with MSVC",
      "inherits": "base-ci",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_FLAGS": "/std:c++latest /EHsc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-clang",
      "configurePreset": "host-clang"
    },
    {
      "name": "linux-gcc-16",
      "configurePreset": "linux-gcc-16"
    },
    {
      "name": "linux-gcc-16-non-hardened",
      "configurePreset": "linux-gcc-16-non-hardened"
    },
    {
      "name": "linux-clang-23",
      "configurePreset": "linux-clang-23"
    },
    {
      "name": "mac-clang",
      "configurePreset": "mac-clang"
    },
    {
      "name": "windows-clang",
      "configurePreset": "windows-clang"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-clang",
      "configurePreset": "host-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-gcc-16",
      "configurePreset": "linux-gcc-16",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-gcc-16-non-hardened",
      "configurePreset": "linux-gcc-16-non-hardened",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-clang-23",
      "configurePreset": "linux-clang-23",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mac-clang",
      "configurePreset": "mac-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-clang",
      "configurePreset": "windows-clang",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
